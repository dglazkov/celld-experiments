{
  "name": "celld-chat",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Distributed chat on a self-hosted celld fleet, built with Vite",
  "scripts": {
    "dev": "concurrently -k -n vite,celld -c cyan,magenta \"vite\" \"celld dev --port 9876\"",
    "dev:vite": "vite",
    "dev:celld": "celld dev --port 9876",
    "build": "tsc -b && vite build",
    "preview": "npm run build && celld dev --port 9876",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "deploy": "npm run build && celld deploy .",
    "fleet:local": "./scripts/local-fleet.sh",
    "fleet:up": "./deploy/exe-up.sh",
    "fleet:down": "./deploy/exe-down.sh"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vite": "^7.1.0",
    "@types/node": "^22.10.0"
  }
}
